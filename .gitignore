# --- Credentials. Never, under any circumstances. ---
.env
client_secrets.json
*.pickle
*.enc
*.bak.*

# --- Your channel's data. If you fork this repo, this is what must not leave
#     your machine: metrics, reports, images and transcripts.
#     Contents are ignored, the directories are kept, so the paths the install
#     guide tells you to use already exist on a fresh clone. ---
data/auth/*
!data/auth/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/history/*
!data/history/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/transcripts/*
!data/transcripts/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep
data/packaging/*
!data/packaging/.gitkeep
data/images/*
!data/images/.gitkeep

# The memory is yours. Uncomment the next line if you would rather not version
# it even in a private repo.
# memory/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- macOS ---
.DS_Store

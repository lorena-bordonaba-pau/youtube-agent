{
  "permissions": {
    "allow": [
      "Bash(python3 tools/*)",
      "Bash(yt-dlp *)",
      "Bash(whisper-cli *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/init.py"
          }
        ]
      }
    ]
  }
}

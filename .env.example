# Copy this file to `.env` and fill in what you use. `.env` is git-ignored.
#
# It is loaded by `tools/lib/base.py` on import, which is the first thing every
# tool does. A variable already present in the real environment is NOT
# overwritten: exporting it in your shell still wins over this file.

# --- YouTube ---------------------------------------------------------------
# An API key is enough for ALL public data: any channel's stats, video data,
# search, thumbnails, transcripts, keywords and outliers. No OAuth needed.
# Create it at console.cloud.google.com > APIs & Services > Credentials,
# after enabling YouTube Data API v3.
YOUTUBE_API_KEY=

# For your OWN channel's analytics (retention, traffic, demographics) an API
# key is not enough: that data is private. See step 2 of docs/install.md.

# --- Image generation (optional) -------------------------------------------
# Only for the visual branch. Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Using an image MCP instead? No key here: declare the server in .mcp.json and
# set "provider": "mcp" in config/image_providers.json.
